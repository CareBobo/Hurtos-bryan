# Configuración de Conexión a Base de Datos PostgreSQL Neon
# Reemplaza con tu cadena de conexión copiada desde la consola de Neon (https://console.neon.tech)
# Ejemplo: postgresql://neondb_owner:npg_xxxxxx@ep-cool-fog-123456.us-east-2.aws.neon.tech/hurto_colombia?sslmode=require
NEON_CONN=postgresql://neondb_owner:TU_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Conexión local alternativa de respaldo (opcional)
LOCAL_PG_CONN=postgresql://postgres:postgres@localhost:5432/hurto_colombia

